# Response headers for Cloudflare static assets.
# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
#
# Vercel ignores this file, so it is additive — it does not change the current
# host's behaviour.

# Fingerprinted build output never changes under the same name.
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Photos and icons are replaced by editors through the CMS, so allow caching but
# let a changed file take effect the same day rather than in a year.
/media/*
  Cache-Control: public,max-age=86400,stale-while-revalidate=604800

# Keep the editor out of search results. The page carries a robots meta tag, but
# config.yml is not HTML and cannot, and it lists the repository and the site's
# whole content structure.
/admin
  X-Robots-Tag: noindex, nofollow
/admin/*
  X-Robots-Tag: noindex, nofollow

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
