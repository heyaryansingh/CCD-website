# Excludes repo-root-only directories from Vercel deploys.
#
# ⚠️ EVERY PATTERN MUST START WITH "/" — these are gitignore-style globs, so an
# unanchored "scripts/" matches a directory called scripts at ANY depth. That
# silently excluded ccd-website/scripts/ and broke the build with
# "Cannot find module .../scripts/bundle-pages.mjs". The leading slash pins each
# pattern to the repository root.
#
# The heavy media directories matter because a CLI deploy from the repo root
# otherwise walks into 61GB of OneDrive-synced files and fails with EBUSY.

/Cooperative Community Development Inc/
/website-media-filebase/
/Shoe Drive CCD/
/building-the-block-prototype/

# Repo-root docs and tooling — not needed to build the site
/assets/
/docs/
/wix-migration-kit/
/scripts/
/.agent-orchestration/
